      },
      "e11LayerCLayout": {
        "type": "object",
        "properties": {
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "radius": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "width",
          "height",
          "radius"
        ],
        "additionalProperties": false
      },
      "e11LayerCInitialPosition": {
        "description": "Explicit initial Layer C position in the draggable bounds coordinate space (.experiment-four-layer-a__bezel-inset). Set on the standardized reference saves so they open exactly where Save 248 Layer C sits.",
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false
      },
      "displayId": {
        "description": "Display identifier for a lettered variant of another save (e.g. 1068b). Labelling and list ordering only; the numeric id remains authoritative.",
        "type": "string",
        "pattern": "^[0-9]+[a-z]$"
      },
      "e1": {
        "type": "object"
      },
      "e2": {
        "type": "object"
      },
      "e3": {
        "type": "object"
      },
      "e4": {
        "type": "object"
      }
