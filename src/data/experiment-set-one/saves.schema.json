          "liquid-glass-shader:lens",
          "pure-css-ios-26:glass-container",
          "liquid-glass-js:rounded-rectangle",
          "liquid-dom:notification-center-main:358x140-r54",
          "liquid-dom:notification-center-dock:358x140-r54",
          "liquid-dom:ios-notification-banner:358x140-r54",
          "lucas-romero:macos-dock-shell:358x140-r54",
          "apple-liquid-glass:shader-shell:358x140-r54",
          "frontend-vue:app-card:358x140-r54",
          "css-liquid-glass-switcher:switcher:358x140-r54",
          "liquid-glass-dist:glass:358x140-r54",
          "chromium-configurable-glass:requested:358x140-r54",
          "liquid-glass-shader:lens:358x140-r54",
