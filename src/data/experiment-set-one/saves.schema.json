{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment Set One Saves",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "label",
      "savedAt",
      "e1",
      "e2",
      "e3"
    ],
    "properties": {
      "id": {
        "type": "integer"
      },
      "label": {
        "type": "string"
      },
      "savedAt": {
        "type": "string",
        "format": "date-time"
      },
      "scope": {
        "type": "string",
        "enum": [
          "one",
          "two",
          "three",
          "four",
          "five",
          "six",
          "seven",
          "eight",
          "nine",
          "ten",
          "eleven",
          "general"
        ]
      },
      "generalPreset": {
        "type": "string"
      },
      "panelPosition": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "cornersOnly": {
        "type": "boolean"
      },
      "sourceSaveId": {
        "type": "integer"
      },
      "e11LayerCReferencePreset": {
        "type": "string",
        "enum": [
          "liquid-main:custom-300x200",
          "liquidgl:demo-1-nav",
          "fluid-glass:lens",
          "fluid-glass:frosted",
          "fluid-glass:bar",
          "fluid-glass:diamond",
          "fluid-glass:fluid",
          "liquid-web:apple",
          "liquid-web:library-default",
          "liquid-web:fishbowl",
          "liquid-web:frosted",
          "liquid-web:prism",
          "liquid-web:flat-pane",
          "liquid-web:hero-circle",
          "liquid-web:reading-glass",
          "liquid-web:orbit",
          "liquid-web:engine-panel",
          "wge-next:form-submit-button",
          "wge-next:bottom-bar",
          "web-glass:thick-lens",
          "web-glass:razor-edge",
          "web-glass:bottom-bar",
          "web-glass:stress-panel",
          "web-glass:storybook",
          "glass-surface:component-default",
          "glass-surface:upstream-demo",
          "glass-surface:ios-pill",
          "glass-surface:prism",
          "glass-surface:achromatic",
          "glass-surface:convex",
          "liquid-dom:notification-center-main",
          "liquid-dom:notification-center-dock",
          "liquid-dom:ios-notification-banner",
          "lucas-romero:macos-dock-shell",
          "apple-liquid-glass:shader-shell",
          "frontend-vue:app-card",
          "css-liquid-glass-switcher:switcher",
          "liquid-glass-dist:glass",
