{
  "name": "@liquid-dom/react",
  "version": "0.1.1",
  "description": "Vendored authoritative Liquid DOM React build for Experiment Eleven.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@liquid-dom/core": "0.1.1",
    "@liquid-dom/layout": "0.2.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
